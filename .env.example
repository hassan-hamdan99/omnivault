# Omnivault — variáveis de ambiente (todas opcionais).
# Copia este ficheiro para `.env` e ajusta conforme necessário.

# Tamanho máximo do cache de ficheiros completos descarregados (GB).
CACHE_MAX_GB=15

# Host/porta do servidor.
#   HOST=0.0.0.0 torna a app acessível na rede local (PC + iPhone). Esse é o
#   comportamento pretendido. Usa HOST=127.0.0.1 para restringir só a esta máquina.
HOST=0.0.0.0
PORT=8000

# Não abrir o browser automaticamente ao iniciar (1 = não abrir).
NO_BROWSER=0

# Nº máximo de extrações pesadas simultâneas (7-Zip/PyMuPDF).
EXTRACT_WORKERS=4

# Origens extras autorizadas a chamar a API (separadas por vírgula). Vazio por padrão:
# o app (PC, iPad, celular) é sempre mesma origem e NÃO precisa disto. Chamadas de
# outras origens (sites de terceiros) são recusadas com 403.
# CORS_ORIGINS=http://outro-app.local:3000

# Pasta onde ficam data/, cache/ e credentials/ (padrão: a pasta do projeto).
# OMNIVAULT_HOME=D:\OmnivaultDados

# Redirect OAuth do Google (derivado de PORT por defeito).
# OAUTH_REDIRECT=http://localhost:8000/auth/callback

# Migração legada: pastas do Drive na 1ª execução (depois usa-se data/config.json).
# Formato: Nome:ID,Nome:ID
# DRIVE_FOLDERS=Marvel:xxxxxxxxxxxxxxxxxxxxx,DC:yyyyyyyyyyyyyyyyyyyyy
